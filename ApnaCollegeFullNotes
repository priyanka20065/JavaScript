// ======================================================
// EVENT FLOW IN BROWSER
// ======================================================

// When an event occurs, it moves through 3 phases:

// 1️⃣ Capturing Phase
// Event travels from document → html → body → parent → target

// 2️⃣ Target Phase
// Event reaches the actual element that triggered it

// 3️⃣ Bubbling Phase
// Event goes back upward from target → parent → body → html → document

console.log("Event flow: Capturing → Target → Bubbling");


// ======================================================
// CREATE DEMO ELEMENTS FOR TESTING
// ======================================================

// Creating parent div
let parent = document.createElement("div");
parent.id = "parent";
parent.style.padding = "40px";
parent.style.background = "#ddd";

// Creating child button
let child = document.createElement("button");
child.id = "child";
child.textContent = "Click Me";

// append button to parent
parent.append(child);

// append parent to page
document.body.append(parent);


// ======================================================
// 1️⃣ EVENT BUBBLING
// ======================================================

// Definition:
// Event bubbling means when an event happens on an element,
// it first runs on that element, then propagates upward
// through its parent elements.

console.log("----- EVENT BUBBLING EXAMPLE -----");

// parent event
parent.addEventListener("click", () => {
    console.log("Parent clicked (Bubbling)");
});

// child event
child.addEventListener("click", () => {
    console.log("Child clicked");
});

// If you click the button:
// Output:
// Child clicked
// Parent clicked
// because event bubbles upward.


// ======================================================
// STOPPING EVENT BUBBLING
// ======================================================

// Sometimes we don't want the event to move to parent elements.
// We use event.stopPropagation()

child.addEventListener("click", (e) => {

    console.log("Child clicked again");

    // stop event from bubbling up
    e.stopPropagation();

});


// ======================================================
// 2️⃣ EVENT CAPTURING
// ======================================================

// Definition:
// Event capturing is the opposite of bubbling.
// The event travels from the top of the DOM
// down to the target element.

// Default event behavior is bubbling.
// To enable capturing, we pass TRUE as third parameter.

console.log("----- EVENT CAPTURING EXAMPLE -----");

parent.addEventListener("click", () => {

    console.log("Parent clicked (Capturing)");

}, true); // true enables capturing phase


// Order becomes:
// Parent (capturing)
// Child
// Parent (bubbling)


// ======================================================
// 3️⃣ EVENT DELEGATION
// ======================================================

// Definition:
// Event delegation means attaching a single event listener
// to a parent element instead of multiple listeners
// on many child elements.

// It works because of event bubbling.

console.log("----- EVENT DELEGATION EXAMPLE -----");

// create container
let container = document.createElement("div");

container.id = "container";
container.style.marginTop = "20px";

// add buttons inside container
container.innerHTML = `
<button>Button 1</button>
<button>Button 2</button>
<button>Button 3</button>
`;

document.body.append(container);

// instead of adding event to each button,
// we add ONE event to the parent container

container.addEventListener("click", (e) => {

    // e.target = element that was clicked

    if(e.target.tagName === "BUTTON"){

        console.log("Delegated Click:", e.target.textContent);

    }

});


// ======================================================
// WHY EVENT DELEGATION IS IMPORTANT
// ======================================================

// 1️⃣ Better performance
// Only one event listener instead of many

// 2️⃣ Works with dynamically created elements

// Example: adding new button dynamically

let newButton = document.createElement("button");

newButton.textContent = "New Dynamic Button";

container.append(newButton);

// This button will also work automatically
// because the event is on the parent.


// ======================================================
// EVENT OBJECT IMPORTANT PROPERTIES
// ======================================================

container.addEventListener("click", (event) => {

console.log("Event type:", event.type);

console.log("Target element:", event.target);

console.log("Current target:", event.currentTarget);

});


// target vs currentTarget

// target = element that triggered event
// currentTarget = element where listener is attached


